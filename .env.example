# Frontend Environment Variables

# The URL for the API Gateway backend.
# In production, this is populated automatically by deploy-frontend.sh
# In development, you can point it to your deployed API Gateway.
VITE_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com

# Example API Key (If implemented in TASK-001)
# VITE_API_KEY=your_secret_api_key_here
